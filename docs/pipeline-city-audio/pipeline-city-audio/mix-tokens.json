{
 "version": 1,
 "sampleRate": 48000,
 "codec": "ogg-vorbis",
 "basePath": "audio/",
 "buses": {
  "master": {
   "defaultDb": 0.0
  },
  "music": {
   "defaultDb": -8.0
  },
  "sfx": {
   "defaultDb": 0.0
  },
  "ui": {
   "defaultDb": -3.0
  },
  "ambience": {
   "defaultDb": 0.0
  }
 },
 "sliders": {
  "_doc": "Settings sliders 0..100 %, gain = (v/100)^2 on top of the bus default; 0 % = silent. 'sounds' drives sfx and ui together.",
  "master": {
   "default": 100,
   "buses": [
    "master"
   ]
  },
  "music": {
   "default": 100,
   "buses": [
    "music"
   ]
  },
  "sounds": {
   "default": 100,
   "buses": [
    "sfx",
    "ui"
   ]
  },
  "ambience": {
   "default": 100,
   "buses": [
    "ambience"
   ]
  },
  "stepPercent": 5,
  "storageKey": "pipeline-city.audio"
 },
 "ducking": {
  "_doc": "Music and ambience dip under cues (cue-clarity measure). Gain ramps; the deepest active duck wins.",
  "targets": [
   "music",
   "ambience"
  ],
  "attackMs": 10,
  "holdMs": 150,
  "releaseMs": 400,
  "cueDuckDb": {
   "standard": -2.0,
   "key": -3.0,
   "failure": -4.0,
   "milestone": -4.0
  }
 },
 "pause": {
  "_doc": "speed === 0: the AudioContext keeps running; nothing is suspended.",
  "fadeMs": 1000,
  "musicHold": {
   "_doc": "tempo is fixed at 66 bpm (no nudge from speed or pause). The darkening is built into music_pausebed_{KEY} (equal-power crossfade from the bed); the pluck layer goes through a low-pass at -5 dB. Details: audio/music/music-spec.json -> pause.",
   "tempoScale": 1.0,
   "lowpassHz": 850,
   "pluckDb": -5.0
  },
  "ambienceGainDb": {
   "amb_room_city_loop": 0.0,
   "amb_machine_hum_loop": -4.0
  },
  "uiDuringPause": "normal",
  "sfxDuringPause": "normal"
 },
 "hiddenTab": {
  "_doc": "document.visibilityState === 'hidden'",
  "fadeOutMs": 500,
  "suspendAfterMs": 2000,
  "fadeInMs": 800
 },
 "unlock": {
  "_doc": "browsers start the AudioContext suspended; resume() on the first pointerdown/keydown/touchend.",
  "events": [
   "pointerdown",
   "keydown",
   "touchend"
  ]
 },
 "voices": {
  "global": 24,
  "sfx": 12,
  "ui": 6,
  "stealPolicy": "lowest priority, then oldest"
 },
 "ambience": {
  "amb_room_city_loop": {
   "bus": "ambience",
   "fadeInMs": 2000,
   "fadeOutMs": 1500,
   "when": "room scene visible (main menu and game; not Build/Gallery studio)",
   "samples": 1152000
  },
  "amb_machine_hum_loop": {
   "bus": "ambience",
   "fadeInMs": 1200,
   "fadeOutMs": 900,
   "when": "snapshot.powered",
   "fanFollow": {
    "_doc": "x = mean DeviceSnap.fan of fan-bearing devices (0..1), else 0.5",
    "gainDbAt0": -6.0,
    "gainDbAt1": 0.0,
    "rateAt0": 0.92,
    "rateAt1": 1.12,
    "smoothMs": 800
   },
   "samples": 576000
  }
 },
 "levelUp": {
  "_doc": "Level-up stinger (level_up__<new key>). quantise: beat = plays on the music clock's next beat (owner choice, ticket #55; SPEC bar line superseded); no music clock: at once. Reached levels in one tick: one stinger.",
  "quantise": "beat"
 },
 "transpose": {
  "_doc": "Key root pitch class for game level L: (5 + 7*(L-1)) mod 12 (F Lydian at level 1, up a fifth per level). Pitched cues: pick the render root with the smallest signed distance d in -6..5 and play at playbackRate 2^(d/12) (|d| <= 1). Level-up: play level_up__<NEW key>.ogg at rate 1 on the next beat (levelUp.quantise; music clock); with no music clock, 0 ms.",
  "levelOneKeyPc": 5,
  "stepSemitones": 7,
  "renderRoots": {
   "F": 5,
   "Gs": 8,
   "B": 11,
   "D": 2
  },
  "keyNames": [
   "C",
   "Cs",
   "D",
   "Ds",
   "E",
   "F",
   "Fs",
   "G",
   "Gs",
   "A",
   "As",
   "B"
  ],
  "_keyNamesDoc": "indexed by pitch class; the same file tokens as the music lane (s = sharp, URL-safe). Level order: F C G D A E B Fs Cs Gs Ds As"
 },
 "fileTargets": {
  "_doc": "max momentary loudness (BS.1770, 400 ms) per file, LUFS; peaks <= -1.2 dBTP",
  "ui.micro": -38.0,
  "ui.tick": -42.0,
  "ui.action": -32.0,
  "ui.transition": -30.0,
  "ui.important": -28.0,
  "sfx.minor": -26.0,
  "sfx.standard": -23.0,
  "sfx.key": -20.0,
  "sfx.stinger": -18.0,
  "ambienceIntegrated": {
   "amb_room_city_loop": -40.0,
   "amb_machine_hum_loop": -38.0
  }
 },
 "logRules": [
  {
   "kind": "install",
   "match": "will be swapped in",
   "cue": "swap_queued"
  },
  {
   "kind": "install",
   "match": "queued installs? cancelled|queued swap was dropped",
   "cue": "swap_cancelled"
  },
  {
   "kind": "install",
   "match": "removed|came off",
   "cue": "uninstall"
  },
  {
   "kind": "install",
   "match": "installed|placed next to|formatted",
   "cue": "install"
  },
  {
   "kind": "cable",
   "match": "came unplugged",
   "cue": "cable_unplugged"
  },
  {
   "kind": "cable",
   "match": "disconnected",
   "cue": "cable_disconnect"
  },
  {
   "kind": "cable",
   "match": "connected",
   "cue": "cable_connect"
  },
  {
   "kind": "power",
   "match": "powered on|reconnected",
   "cue": "power_on"
  },
  {
   "kind": "power",
   "match": "powered off",
   "cue": "power_off"
  },
  {
   "kind": "key",
   "match": "refused|pulled before",
   "cue": "key_refused"
  },
  {
   "kind": "key",
   "match": "plugged in",
   "cue": "key_plug"
  },
  {
   "kind": "key",
   "match": "told two friends",
   "cue": "new_clients"
  },
  {
   "kind": "job",
   "match": "",
   "cue": "job_fulfilled"
  },
  {
   "kind": "payout",
   "match": "\\(late\\)$",
   "cue": "payout_late"
  },
  {
   "kind": "payout",
   "match": "",
   "cue": "payout"
  },
  {
   "kind": "drop",
   "match": "",
   "cue": "client_drop"
  },
  {
   "kind": "expire",
   "match": "",
   "cue": "job_expired"
  },
  {
   "kind": "decline",
   "match": "",
   "cue": "job_declined"
  },
  {
   "kind": "level",
   "match": "",
   "cue": null
  },
  {
   "kind": "ecc",
   "match": "",
   "cue": "ecc"
  },
  {
   "kind": "fault",
   "match": "crashed and rebooted",
   "cue": "fault_crash"
  },
  {
   "kind": "fault",
   "match": "VRM burnt out|cut the wall|power cord was pulled|hard power-off",
   "cue": "fault_hard"
  },
  {
   "kind": "fault",
   "match": "",
   "cue": "fault_soft"
  },
  {
   "kind": "purchase",
   "match": "^sold",
   "cue": "sell"
  },
  {
   "kind": "purchase",
   "match": "",
   "cue": "purchase"
  },
  {
   "kind": "bill",
   "match": "^paid",
   "cue": "bill_paid"
  },
  {
   "kind": "bill",
   "match": "",
   "cue": "bill_issued"
  },
  {
   "kind": "contract",
   "match": "accepted",
   "cue": "contract_accepted"
  },
  {
   "kind": "contract",
   "match": "",
   "cue": "contract_ended"
  },
  {
   "kind": "net",
   "match": "link up",
   "cue": null
  },
  {
   "kind": "net",
   "match": "",
   "cue": "ui_notify"
  },
  {
   "kind": "sandbox",
   "match": "",
   "cue": "ui_notify"
  }
 ],
 "music": {
  "_doc": "Afterglow music lane. The engine reads the full rules from audio/music/music-spec.json (states, events, clock, key change); these are the values the mixer needs. Speed changes only density and brightness (music-spec.json -> speed).",
  "spec": "audio/music/music-spec.json",
  "bus": "music",
  "tempoBpm": 66,
  "tempoFollowsSpeed": false,
  "loopSamples": 698182,
  "menuLoopSamples": 1396364,
  "loopPadSamples": 4800,
  "levelupWithSfxDb": -6.0,
  "levelupWithSfxDoc": "music_levelup_{KEY} plays at -6 dB whenever the SFX stinger level_up__{KEY} plays on the same bar (both are kept)",
  "menu": {
   "file": "audio/music/stems/music_menu_F.ogg",
   "rule": "the menu always uses music_menu_F; on the first game frame crossfade (2 s, on the next menu bar) to the save's key stems"
  },
  "preload": "current key + next key (+7 semitones) decoded; ~34 MB decoded per key",
  "layerGainDb": {
   "bed": 0.0,
   "pluck": -2.0,
   "bass": -5.0,
   "shimmer": -7.0,
   "stress": -6.0,
   "pausebed": 1.0,
   "menu": 2.5
  },
  "cueGainDb": {
   "pluck": 2.0,
   "glint": 0.0,
   "low": 1.0,
   "levelup": 0.0,
   "fault": 0.0
  },
  "trimDb": 0.3
 },
