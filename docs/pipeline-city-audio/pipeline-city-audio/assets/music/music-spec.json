{
 "version": "1.0 (2026-11-21)",
 "direction": "B, Afterglow",
 "format": {
  "container": "ogg",
  "codec": "vorbis",
  "quality": 6,
  "sample_rate": 48000,
  "channels": 2,
  "note": "Matches the docs lane decision (handoff SPEC.md \u00a71.1: Ogg Vorbis q6, 48 kHz, stereo). Masters are 24-bit WAV in sources/masters/.",
  "loop_padding": {
   "samples_each_side": 4800,
   "loopStart_samples": 4800,
   "loopEnd_samples": "LOOP_PAD + loop_samples",
   "why": "the Ogg stems carry 100 ms of wrap-around audio before and after the loop so the seam is mid-stream; set loopStart/loopEnd, and run stitchLoop() once after decode (music-spec.md \u00a76)"
  }
 },
 "clock": {
  "bpm_nominal": 66,
  "beats_per_bar": 4,
  "subdivisions_per_beat": 12,
  "loop_bars": 4,
  "loop_samples": 698182,
  "loop_seconds": 14.545458333333332,
  "bar_seconds": 3.636364583333333,
  "beat_seconds": 0.9090911458333333,
  "rule": "Derive beat/bar from the stem length (loop_seconds/16), not from 60/66: the stems are exactly 698182 samples (65.99997 bpm), so the grid never drifts from the audio.",
  "tempo_follows_game_speed": false,
  "tempo_changes_with_stress": false
 },
 "transposition": {
  "approach": "rendered_12_keys",
  "why": "playbackRate transposition also changes loop length (up to +/-6 semitones = -29%/+41% duration), which breaks bar sync between layers and the beat grid; time-stretch in the browser is not available. Rendering all 12 keys keeps every stem exactly 4 bars at 66 bpm with no pitch-shift artefacts. Cost is ~1.0 MB per key for the 6 keyed layers; only the current and next key are ever decoded.",
  "keys_in_level_order": [
   "F",
   "C",
   "G",
   "D",
   "A",
   "E",
   "B",
   "Fs",
   "Cs",
   "Gs",
   "Ds",
   "As"
  ],
  "file_key_tokens": {
   "F": "F",
   "C": "C",
   "G": "G",
   "D": "D",
   "A": "A",
   "E": "E",
   "B": "B",
   "Fs": "F#",
   "Cs": "C#",
   "Gs": "G#",
   "Ds": "D#",
   "As": "A#"
  },
  "key_for_level": "KEYS[(level - 1) % 12]  // root pc = (5 + 7*(level-1)) mod 12; level 13 = F again",
  "bed_root_midi": {
   "F": 41,
   "C": 48,
   "G": 43,
   "D": 50,
   "A": 45,
   "E": 40,
   "B": 47,
   "Fs": 42,
   "Cs": 49,
   "Gs": 44,
   "Ds": 51,
   "As": 46
  }
 },
 "layers": {
  "bed": {
   "file": "stems/music_bed_{KEY}.ogg",
   "role": "pad bed: root+5th+9th held, upper voices I (bars 1-2) -> II/I (bars 3-4)",
   "keyed": true
  },
  "pluck": {
   "file": "stems/music_pluck_{KEY}.ogg",
   "role": "soft echoing pluck pattern D4-A5, dotted-eighth echoes",
   "keyed": true
  },
  "bass": {
   "file": "stems/music_bass_{KEY}.ogg",
   "role": "soft pulse/bass on beats 1, 2.5, 3, 4.5 (E1-D#2 + harmonics)",
   "keyed": true
  },
  "shimmer": {
   "file": "stems/music_shimmer_{KEY}.ogg",
   "role": "data-flow shimmer: triplet-8th blips C6-C7 + soft 16th ticks",
   "keyed": true
  },
  "stress": {
   "file": "stems/music_stress_{KEY}.ogg",
   "role": "overload: upper voices +28 cents with 16th tremolo + sharp off-beat plucks",
   "keyed": true
  },
  "pausebed": {
   "file": "stems/music_pausebed_{KEY}.ogg",
   "role": "pause/hold bed: same chords, darker (2.5 kHz), slower crossfades",
   "keyed": true
  },
  "menu": {
   "file": "stems/music_menu_F.ogg",
   "role": "title/menu loop, F Lydian only, 8 bars (1396364 samples), no bass/shimmer",
   "keyed": false,
   "loop_bars": 8
  }
 },
 "notes": {
  "pluck": {
   "file": "notes/music_note_pluck_{NOTE}.ogg",
   "range": "C3..C6 chromatic (37)",
   "use": "build + flow event notes; quiet step note in pause"
  },
  "glint": {
   "file": "notes/music_note_glint_{NOTE}.ogg",
   "range": "C5..C7 chromatic (25)",
   "use": "payout fans, ecc, net, bill paid"
  },
  "low": {
   "file": "notes/music_note_low_{NOTE}.ogg",
   "range": "C2..C3 chromatic (13)",
   "use": "drop, expire, cable unplugged (with pluck)"
  },
  "note_token": "C, Cs, D ... B + octave (MIDI 60 = C4); dry samples, runtime adds the cue echo + reverb send",
  "levelup": {
   "file": "notes/music_levelup_{KEY}.ogg",
   "use": "musical transition chord for the key change, in the NEW key, on the bar line. SFX lane's level-up UI sound must be unpitched or play its pitched part from this chord's notes; this file is the musical part."
  },
  "fault": {
   "file": "notes/music_fault_{KEY}.ogg",
   "use": "crash: low falling 5th -> root + dark swell, current key"
  }
 },
 "registers": {
  "build": [
   60,
   72
  ],
  "flow": [
   72,
   84
  ],
  "glint": [
   76,
   96
  ],
  "milestone": [
   48,
   84
  ],
  "failure": [
   36,
   48
  ],
  "rule": "event note = nearest current-scale tone inside its family register; degrees per event below"
 },
