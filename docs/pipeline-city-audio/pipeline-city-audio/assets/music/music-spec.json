  "music_trim_db": 0.3,
  "layer_gain_db": {
   "bed": 0.0,
   "pluck": -2.0,
   "bass": -5.0,
   "shimmer": -7.0,
   "stress": -6.0,
   "pausebed": 1.0,
   "menu": 2.5
  },
  "cue_gain_db": {
   "pluck": 2.0,
   "glint": 0.0,
   "low": 1.0,
   "levelup": 0.0,
   "fault": 0.0
  },
  "levelup_with_sfx_db": -6.0,
  "cue_echo": {
   "delay_beats": 0.75,
   "level_db": -12,
   "feedback": 0.3,
   "first_hit_dry": true
  },
  "cue_reverb_send": 0.18,
  "stem_file_lufs": -20.0,
  "note_file_lufs": -20.0,
  "stinger_file_lufs": -18.0,
  "measured": {
   "all_layers_on_lufs_range": [
    -16.1,
    -15.9
   ],
   "all_layers_on_max_true_peak_dbtp": -1.0,
   "running_no_stress_lufs_mean": -16.5,
   "pause_lufs_mean": -18.3,
   "menu_lufs": -17.2
  }
 },
 "ducking": {
  "trigger": "any cue (music notes, stingers, SFX accents): uses the docs lane's mix-tokens ducking on the whole music bus; the music-note sub-bus itself is not ducked",
  "standard_db": -2,
  "key_db": -3,
  "bed_db": -3,
  "milestone_db": -4,
  "failure_db": -4,
  "attack_s": 0.01,
  "hold_s": 0.15,
  "release_s": 0.4,
  "music_events_as": {
   "install": "standard",
   "cable": "standard",
   "power": "standard",
   "key": "key",
   "job": "key",
   "payout": "key",
   "ecc": "standard",
   "net": "standard",
   "contract": "standard",
   "bill": "standard",
   "drop": "failure",
   "expire": "failure",
   "fault": "failure",
   "level": "milestone"
  }
 },
 "voices": {
  "cue_max": 8,
  "cue_steal": "oldest",
  "per_kind_min_interval_s": {
   "install": 0.08,
   "cable": 0.08,
   "power": 0.25,
   "key": 0.15,
   "job": 0.15,
   "payout": "merge all payouts inside 1 beat into one fan",
   "ecc": 0.909,
   "net": 3.636,
   "drop": 0.45,
   "expire": 0.45,
   "contract": 0.909,
   "bill": 0.909
  },
  "stems_playing": "<= 7 BufferSources steady state; <= 14 during a 1.4 s key crossfade"
 },
 "quantize": {
  "player_input": "none (play now): install, uninstall, cable connect/disconnect, power, key plug",
  "sim_events": "1/12 beat",
  "loop_layer_entry": "bar",
  "layer_exit": "beat",
  "key_change": "bar",
  "stingers": "bar (levelup) / beat (fault)",
  "note": "The game reports install/cable/power/key as log notes from the sim; if the UI can tell the action came from the player this frame, play now, else snap to 1/12."
 },
 "states": {
  "menu": {
   "when": "main menu screens 01/02, new game 04, load confirm 05, settings 06, controls from menu 09",
   "play": {
    "menu": 1
   },
   "fade_s": 2.0
  },
  "loading": {
   "when": "loading 03",
   "play": {
    "menu": 1
   },
   "note": "menu keeps going; crossfade to game on first frame 11, on the next menu bar, 2 s"
  },
  "off": {
   "when": "Phase 'off' (in game, machine off)",
   "play": {
    "bed": 0.5
   },
   "fade_s": 2.0
  },
  "boot": {
   "when": "Phase posting|mounting|loading|booting-os",
   "play": {
    "bed": 1,
    "pluck": 0.5
   },
   "events": "rising pluck per 1/6 of bootProgress (degrees 0,2,4,6,7,9)"
  },
  "idle": {
   "when": "Phase idle-os|halted|waiting-for-key|done-remove-key",
   "play": {
    "bed": 1,
    "pluck": 0.6
   }
  },
  "running": {
   "when": "Phase running|running-os|ingesting|flashing|writing",
   "play": {
    "bed": 1,
    "pluck": 1,
    "bass": 1
   }
  },
  "data": {
   "when": "any LinkState link-up or saturated, or a TransferSnap / KeyStage ingesting|downloading|uploading",
   "play": {
    "shimmer": 1
   },
   "saturated": {
    "shimmer_db": 2,
    "shimmer_lowpass_hz": 4000
   },
   "exit": "LinkState down|no-cable|no-os|no-device: shimmer fades out over 1 bar"
  },
  "stress": {
   "amount": "max(1-throttle, (tempC-tWarn)/(tMax-tWarn), vrm.loadRatio-1, power.totalW/budgetW-0.9)/scale, clamp 0..1",
   "gain": "stress^1.5 (linear)",
   "fade": "1 bar in, 1 bar out",
   "cap": "never more than +2 LU on the music bus"
  },
  "error": {
   "when": "Phase 'error' / note fault 'POST failed'",
   "play": {
    "pausebed": 0.7
   },
   "note": "no loops until fixed"
  },
  "hard_failure": {
   "when": "note fault 'VRM burnt out', DeviceSnap.burnt, power.tripped, bill.cut",
   "play": {
    "pausebed": 0.7
   },
   "events": "music_fault_{KEY} once; everything else stops (fade 0.3 s)"
  },
  "debt": {
   "when": "bill.unpaid > 0",
   "effect": "bed + pausebed low-pass 3000 Hz until paid"
  }
 },
 "pause": {
  "when": "speed === 0 (togglePause, HUD button, popupPause, crash). Pause menu screen 10 uses this state too.",
  "fade_s": 1.0,
  "bed_to_pausebed": "equal-power crossfade",
  "pluck_db": -5.0,
  "pluck_lowpass_hz": 850,
  "bass": 0,
  "shimmer": 0,
  "stress": 0,
  "tempo": "unchanged (66); the thinning, darker bed and filter carry the pause",
  "events": "only UI (SFX lane). A step/stepTick plays one pluck at -8 dB through 1500 Hz on the next beat",
  "never": [
   "cut to silence",
   "AudioContext.suspend()",
   "stop the stems"
  ]
 },
 "resume": {
  "when": "speed goes 0 -> >0",
  "quantize": "next beat",
  "fade_s": 1.0,
  "restore": "the target state for the current Phase/links/stress"
 },
 "speed": {
  "tempo_follows": false,
  "why": "Stems are fixed 66 bpm audio; a tempo change would need playbackRate (detunes) or a re-render. Speed changes density and brightness instead (Mini Motorways: density, not tempo).",
  "map": {
   "1": {
    "bass": 0,
    "shimmer_db": -6
   },
   "2": {
    "bass_db": -3,
    "shimmer_db": -3
   },
   "4": {},
   "8": {
    "shimmer_db": 2,
    "event_density": 2
   },
   "12": {
    "shimmer_db": 3,
    "bass_db": 1,
    "event_density": 3
   },
   "16": "as 12",
   "64": "as 12"
  },
  "event_density": "max event notes per beat before merging (payout fans merge, install/cable notes collapse to one per 1/12)",
  "fade_s": 0.5
 },
 "key_change": {
  "trigger": "new snapshot.log entry kind === 'level' (and levelUp signal)",
  "quantize": "next bar line",
  "crossfade_s": 1.4,
  "crossfade": "equal-power, all keyed layers at once",
  "stinger": "music_levelup_{NEW_KEY} on the same bar line, ducks bed -4 dB",
  "multi_level": "one fifth per bar until target; stinger only on the first step",
  "no_transition": "load save, new game, sandbox setLevel: key set from the level on the next bar, 1.4 s crossfade, no stinger (immediate if music not started)",
  "inside_pause": "allowed (popupPause usually starts first): pausebed of old key crossfades to pausebed of new key",
  "preload": "always keep current key and next key (+7 semitones) decoded; if the target is not decoded yet, hold the old key and change on the first bar after decode",
  "register": "bed root E2..D#3 (bed_root_midi); notes take the nearest tone of the new scale in their register"
 },
 "events": {
  "install": {
   "note": "pluck",
   "register": "build",
   "degrees": [
    0
   ],
   "extra": "pluck layer enters on next bar if it was off"
  },
  "uninstall": {
   "note": "pluck",
   "register": "build",
   "degrees": [
    4,
    0
   ],
   "spacing_beats": 0.5,
   "pitch_cents": -20
  },
  "power": {
   "on": "pluck degrees [0,4,7] 1/3 beat apart (build)",
   "off": "bed to 0.5 over 2 s"
  },
  "cable": {
   "connected": "pluck degrees [0, 4] rising, 1/2 beat apart (build)",
   "disconnected": "pluck [4, 0] falling, -25 cents + low root"
  },
  "key": {
   "note": "pluck",
   "register": "flow",
   "degrees": [
    2
   ]
  },
  "job": {
   "note": "pluck",
   "register": "flow",
   "degrees": [
    0
   ]
  },
  "payout": {
   "note": "glint",
   "register": "glint",
   "fan_degrees": [
    0,
    2,
    4,
    6,
    7,
    9
   ],
   "count": "3 + min(3, floor(log10(amount)))",
   "late": "2 notes",
   "spacing_beats": 0.3333
  },
  "drop": {
   "note": "low",
   "register": "failure",
   "degrees": [
    4
   ],
   "pitch_cents": -50,
   "with": "glint degree 3 falling, -50 cents"
  },
  "expire": {
   "note": "low",
   "register": "failure",
   "degrees": [
    2,
    0
   ],
   "spacing_beats": 0.5
  },
  "level": {
   "see": "key_change"
  },
  "fault": {
   "crash": "music_fault_{KEY} on next beat; pluck/bass/shimmer/stress out over 0.15 s; music-bus low-pass to 250 Hz over 0.5 s, back over 2 s when Phase leaves 'error'/'off'; layers re-enter one per beat as their states return",
   "post_failed": "state error",
   "burnt": "state hard_failure"
  },
  "ecc": {
   "note": "glint",
   "register": "glint",
   "degrees": [
    3
   ],
   "gain_db": -4,
   "duck_db": -1
  },
  "net": {
   "link_up": "glint degrees [4, 7] (flow) + data state",
   "link_down": "shimmer fades 1 bar"
  },
  "bill": {
   "paid": "glint degrees [4, 0]",
   "unpaid": "debt state"
  },
  "contract": {
   "accepted": "pluck degrees [4, 8] (flow)",
   "ended": "pluck [8, 4]"
  },
  "purchase": {
   "music": "none; SFX lane owns the purchase sound"
  }
 },
 "hidden_tab": {
  "owner": "docs lane owns the master fade + suspend (IMPLEMENTATION.md)",
  "music_part": [
   "While hidden, ignore state changes and drop queued notes/stingers.",
   "On visible: read the current snapshot, set layer gains straight to their targets (no per-layer fades; the master fade-in covers it), set the key directly if the level changed (no stinger).",
   "The stems keep their phase because the AudioContext is suspended, not stopped; the scheduler recomputes the next bar from ctx.currentTime."
  ]
 },
