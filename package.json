{
  "name": "pipeline-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run --silent check:types && vitest run src/features/economy/ui/shop/stills.test.ts src/features/board/sim/buildstills.test.ts && vite build",
    "preview": "vite preview",
    "prod": "npm run build && vite preview --open",
    "test": "vitest run --project fast",
    "test:q": "npm run test:fast && npm run test:heavy:changed",
    "test:heavy:changed": "vitest run --project heavy --changed origin/main --passWithNoTests --reporter=dot",
    "test:fast": "vitest run --project fast --reporter=dot",
    "test:heavy": "vitest run --project heavy --reporter=dot",
    "test:browser": "vitest run --project browser",
    "bench:speed": "node tools/bench-speed.mjs",
    "bench:3d": "node tools/bench3d.mjs",
    "bench:swap": "node tools/benchswap.mjs",
    "clip:check": "node tools/clipcheck.mjs",
    "bench:4k": "node tools/bench3d.mjs --size 2560x1355 --dpr 1.5 --preset Medium --scale 1 --gpu \"RTX 5080\" --need-timers --only \"room night hover\"",
    "bench:modes": "node tools/bench-modes.mjs",
    "bench:boot": "node tools/bench-boot.mjs",
    "shot": "node tools/shot.mjs",
    "jobsheet": "node tools/jobsheet.mjs",
    "animcheck": "node tools/animcheck.mjs",
    "aircheck": "node tools/aircheck.mjs",
    "powercheck": "node tools/powercheck.mjs",
    "flicker": "node tools/flicker.mjs",
    "bake": "node tools/bake/bake.mjs",
    "stills": "node tools/stills.mjs",
    "buildstills": "node tools/buildstills.mjs",
    "brands": "node tools/brandsheet.mjs",
    "bake:cloth": "node tools/bake-cloth.mjs",
    "bake:lm": "node tools/bake/lightmaps.mjs",
    "bake:tex": "node tools/bake/textures.mjs",
    "bake:models": "node tools/bake/models.mjs",
    "e2e:tutorial": "node e2e/tutorial.e2e.mjs",
    "e2e:errors": "node e2e/errors.e2e.mjs",
    "typecheck": "npm run --silent check:types",
    "check": "node .claude/skills/setup-coding-standards/check.mjs",
    "fix": "node .claude/skills/setup-coding-standards/check.mjs --fix",
    "baseline:update": "node .claude/skills/setup-coding-standards/check.mjs --update-baselines",
    "check:format": "prettier --check . --log-level warn && uvx ruff@0.17.6 format --check tools",
    "check:types": "node .claude/skills/setup-coding-standards/ratchet.mjs tsc -- tsc --noEmit -p .",
    "check:lint": "node .claude/skills/setup-coding-standards/ratchet.mjs oxlint -- oxlint --type-aware -f json .",
    "check:css": "node .claude/skills/setup-coding-standards/ratchet.mjs stylelint -- stylelint \"**/*.css\" -f json",
    "check:md": "node .claude/skills/setup-coding-standards/ratchet.mjs markdownlint -- markdownlint-cli2 \"**/*.md\"",
    "check:dead": "node .claude/skills/setup-coding-standards/ratchet.mjs knip -- knip --reporter json",
    "check:spell": "node .claude/skills/setup-coding-standards/ratchet.mjs cspell -- cspell --no-progress --no-summary \"**/*.{ts,tsx,mjs,md,css}\"",
    "check:py": "node .claude/skills/setup-coding-standards/ratchet.mjs ruff -- uvx ruff@0.17.6 check --output-format json tools",
    "check:pytypes": "basedpyright",
    "check:editor": "editorconfig-checker",
    "fix:lint": "oxlint --type-aware --fix .",
    "fix:py": "uvx ruff@0.17.6 check --fix tools",
    "fix:format": "prettier --write . --log-level warn && uvx ruff@0.17.6 format tools",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@gltf-transform/cli": "^4.5.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.0.5",
    "basedpyright": "1.40.2",
    "cspell": "10.5.2",
    "editorconfig-checker": "6.2.0",
    "knip": "6.48.0",
    "ktx2-encoder": "^0.6.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.2",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright-core": "^1.64.1",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xatlas-wasm": "^0.1.3"
  }
}
