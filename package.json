{
  "name": "pipeline-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prod": "npm run build && vite preview --open",
    "test": "vitest run",
    "test:q": "vitest run --reporter=dot",
    "bench:speed": "node tools/bench-speed.mjs",
    "bench:3d": "node tools/bench3d.mjs",
    "shot": "node tools/shot.mjs",
    "bake": "node tools/bake/bake.mjs",
    "stills": "node tools/stills.mjs",
    "bake:cloth": "node tools/bake-cloth.mjs",
    "e2e:tutorial": "node e2e/tutorial.e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "0.187.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xatlas-wasm": "^0.1.3"
  }
}
